# Host-side tooling only - docker-compose.yml does NOT read this file, its
# own service definitions already hardcode the same credentials/ports (see
# the postgres/redis/nats services there). Copy this to .env and source it
# (or just set these in your shell) to run the Postgres/Redis-gated
# integration tests against the stack `docker compose up -d` starts:
#
#   python -m pytest tests/integration/test_postgres_store.py
#   python -m pytest tests/unit/test_matchmaking_queue.py
#
# Both are skipped by default (see their own skip messages) so a plain
# `python -m pytest` stays infra-free.

# 55432, not Postgres's usual 5432 - this dev machine already has a
# standalone Postgres bound to the real 5432 (see docker-compose.yml's own
# comment on why the container publishes 55432 instead).
KFCHESS_TEST_DATABASE_URL=postgresql://kfchess:kfchess@localhost:55432/kfchess
KFCHESS_TEST_REDIS_URL=redis://localhost:6379/0
